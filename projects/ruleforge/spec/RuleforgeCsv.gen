Language: RuleforgeCsv
Version: 1.0.0

// Comma-separated values as Ruleforge reads dataset snapshots.
//
// This is RFC 4180 (records, header row, double-quote escaping, quoted fields that contain commas and line breaks) with two
// deliberate differences from the strict standard grammar in the Logos library (stdlib/CSV.gen): a record ends with LF, CRLF
// or CR, because spreadsheets and Unix tools write all three, and a field holds any UTF-8 text, because item names such as
// "Maelstrom" in Path of Exile are not ASCII. The scripts' own types decide what a cell means, so no cell is interpreted here.

PARSER {
	entry = #file
}

CONTEXT <ROOT> {
	$text = (!(',' || '"' || '\r' || '\n'))+
	$comma = ','
	$line_end = '\r\n' || '\n' || '\r'
	$quote_open = '"' -> push(QUOTED)
}

CONTEXT <QUOTED> {
	$quoted_text = (!'"')+
	$escaped_quote = '""'
	$quote_close = '"' -> pop(1)
}

#file = #record ($line_end #record)* $line_end?
#record = #field ($comma #field)*
#field = #escaped || $text?
#escaped = $quote_open ($quoted_text || $escaped_quote)* $quote_close
