extensions = filter
scope = source.poe-filter
test.comment = #
sublime.package = User

$comment = comment.line.number-sign
rule #block = keyword.control
$continue = keyword.control
$import = keyword.control.import
$optional = storage.modifier
rule #numeric_condition = variable.language.condition
rule #boolean_condition = variable.language.condition
rule #text_condition = variable.language.condition
rule #modifier_condition = variable.language.condition
$rarity_condition = variable.language.condition
rule #socket_condition = variable.language.condition
rule #color_action = support.function.color
$font_action = support.function
rule #sound_action = support.function
rule #custom_sound_action = support.function
rule #drop_sound_action = support.function
$effect_action = support.function
$icon_action = support.function
$operator = keyword.operator.comparison
rule #boolean = constant.language.boolean
rule #rarity = constant.language.rarity
rule #named_color = support.constant.color
rule #shape = support.constant.shape
$none = constant.language
$temporary = storage.modifier
$socket_pattern = constant.other.socket-pattern
$integer = constant.numeric.integer
$string = string.quoted.double
$word = string.unquoted

rule #header = meta.block
rule #import_line = meta.import
rule #condition = meta.condition
rule #action = meta.action
rule #color_value = meta.color
