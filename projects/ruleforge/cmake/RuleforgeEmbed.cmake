# Embeds text files as C byte arrays: ruleforge_embed(<output.c> <symbol-prefix> <file>...).
# Each file becomes `const unsigned char <prefix>_<stem>[]` (the stem in lower case) plus `<prefix>_<stem>_size`.
# Bytes are written as hex so no compiler's string-literal limit applies (MSVC caps at 16 KiB).
function(ruleforge_embed output prefix)
    set(content "/* Generated by cmake/RuleforgeEmbed.cmake. Do not edit. */\n")
    foreach(input IN LISTS ARGN)
        get_filename_component(stem "${input}" NAME_WE)
        string(MAKE_C_IDENTIFIER "${stem}" stem)
        string(TOLOWER "${stem}" stem)
        file(READ "${input}" hex HEX)
        string(LENGTH "${hex}" hex_length)
        math(EXPR size "${hex_length} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],)" "\\1\n" bytes "${bytes}")
        string(APPEND content "const unsigned char ${prefix}_${stem}[] = {\n${bytes}0x00};\nconst unsigned long ${prefix}_${stem}_size = ${size}UL;\n")
    endforeach()
    file(WRITE "${output}.tmp" "${content}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${output}.tmp" "${output}")
endfunction()

# Embeds the standard-library modules: ruleforge_embed_modules(<output.c> <symbol-prefix> <file>...).
# Every file std/<name>.rf is the module `std.<name>`. The output holds the bytes of each file and three parallel tables the engine
# searches when a script imports a module: names, bytes and sizes, ended by a NULL name.
function(ruleforge_embed_modules output prefix)
    set(content "/* Generated by cmake/RuleforgeEmbed.cmake. Do not edit. */\n")
    set(names "")
    set(datas "")
    set(sizes "")
    foreach(input IN LISTS ARGN)
        get_filename_component(stem "${input}" NAME_WE)
        string(MAKE_C_IDENTIFIER "${stem}" symbol)
        file(READ "${input}" hex HEX)
        string(LENGTH "${hex}" hex_length)
        math(EXPR size "${hex_length} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],)" "\\1\n" bytes "${bytes}")
        string(APPEND content "static const unsigned char ${prefix}_${symbol}[] = {\n${bytes}0x00};\n")
        string(APPEND names "    \"std.${stem}\",\n")
        string(APPEND datas "    ${prefix}_${symbol},\n")
        string(APPEND sizes "    ${size}UL,\n")
    endforeach()
    string(APPEND content "const char *const ${prefix}_names[] = {\n${names}    0};\n")
    string(APPEND content "const unsigned char *const ${prefix}_data[] = {\n${datas}    0};\n")
    string(APPEND content "const unsigned long ${prefix}_sizes[] = {\n${sizes}    0UL};\n")
    file(WRITE "${output}.tmp" "${content}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${output}.tmp" "${output}")
endfunction()
