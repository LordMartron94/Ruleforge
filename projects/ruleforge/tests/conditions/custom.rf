version 1.0.0;
module custom;

import std.conditions;

// A condition the engine has never heard of, declared in the project: a new filter keyword needs no engine update. It stands first in a
// block (order 5), ahead of the built-in BaseType (order 20), however the rule writes them.
export condition delveDepth {
    keyword "DelveDepth";
    accepts int;
    ordered;
    order 5;
}

export condition league {
    keyword "League";
    accepts enum { Standard, Settlers, Necropolis };
    ordered;
    order 6;
}

themeSchema S { a; }
theme T implements S { a { onShow { Background #FF0000; } } }

export func main() {
    emit rule {
        scope { baseType = "Exalted Orb"; }
        baseline { action show; style T.a; }
        variants {
            when delveDepth >= 3 and league == "Settlers" {
                action hide;
                style T.a;
            }
        }
    }
}
