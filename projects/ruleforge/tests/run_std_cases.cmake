# Runs the cases of std/cases.txt: each `expression => expected` is evaluated by `ruleforge eval` and its JSON compared with the expected one.
#   cmake -DRULEFORGE=<exe> -DDIRECTORY=<tests/std> -P run_std_cases.cmake
# Lines are split by hand: a CMake list would treat the brackets and commas of JSON as its own syntax.

# Splits `text` at newlines into the variables <prefix>_0 .. <prefix>_N-1 and sets <prefix>_count.
function(split_lines text prefix)
    set(index 0)
    while(NOT text STREQUAL "")
        string(FIND "${text}" "\n" newline)
        if(newline EQUAL -1)
            set(line "${text}")
            set(text "")
        else()
            string(SUBSTRING "${text}" 0 ${newline} line)
            math(EXPR rest "${newline} + 1")
            string(SUBSTRING "${text}" ${rest} -1 text)
        endif()
        set(${prefix}_${index} "${line}" PARENT_SCOPE)
        math(EXPR index "${index} + 1")
    endwhile()
    set(${prefix}_count ${index} PARENT_SCOPE)
endfunction()

file(READ "${DIRECTORY}/cases.txt" cases_text)
split_lines("${cases_text}" line)
set(imports "")
set(case_count 0)
set(arguments eval "${DIRECTORY}/fixture.rf" --dataset "items=${DIRECTORY}/items.csv" --import fixture)
math(EXPR last_line "${line_count} - 1")
foreach(index RANGE ${last_line})
    set(current "${line_${index}}")
    if(current MATCHES "^# imports: (.*)$")
        string(REPLACE " " ";" imports "${CMAKE_MATCH_1}")
        foreach(import IN LISTS imports)
            list(APPEND arguments --import "${import}")
        endforeach()
    elseif(NOT current STREQUAL "" AND NOT current MATCHES "^#")
        string(FIND "${current}" " => " split REVERSE)
        if(split EQUAL -1)
            message(FATAL_ERROR "not a case (expression => expected): ${current}")
        endif()
        string(SUBSTRING "${current}" 0 ${split} expression)
        math(EXPR value_start "${split} + 4")
        string(SUBSTRING "${current}" ${value_start} -1 value)
        set(expression_${case_count} "${expression}")
        set(expected_${case_count} "${value}")
        list(APPEND arguments -e "${expression}")
        math(EXPR case_count "${case_count} + 1")
    endif()
endforeach()

execute_process(COMMAND "${RULEFORGE}" ${arguments} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE standard_error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "eval failed (${status}):\n${standard_error}${output}")
endif()
string(REGEX REPLACE "\n$" "" output "${output}")
split_lines("${output}" result)
if(NOT result_count EQUAL case_count)
    message(FATAL_ERROR "${case_count} cases but ${result_count} results:\n${output}")
endif()
set(failures "")
math(EXPR last_case "${case_count} - 1")
foreach(index RANGE ${last_case})
    if(NOT "${result_${index}}" STREQUAL "${expected_${index}}")
        string(APPEND failures "  ${expression_${index}}\n    expected ${expected_${index}}\n    got      ${result_${index}}\n")
    endif()
endforeach()
if(NOT failures STREQUAL "")
    message(FATAL_ERROR "standard library cases failed:\n${failures}")
endif()
