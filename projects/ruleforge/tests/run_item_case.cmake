execute_process(COMMAND "${RULEFORGE}" item "${CASE}" --log-dir "${OUTPUT}/logs" RESULT_VARIABLE result OUTPUT_VARIABLE product ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "item parse failed: ${errors}")
endif()
foreach(pair IN ITEMS "baseType|Driftwood Wand" "name|Doom Branch" "class|Wands" "rarity|Rare" "itemLevel|83" "quality|20" "sockets|4" "linkedSockets|3" "identified|OFF" "corrupted|ON")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 key)
    list(GET fields 1 expected)
    string(JSON actual GET "${product}" "${key}")
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${key}: expected ${expected}, got ${actual}")
    endif()
endforeach()
file(READ "${CASE}" text)
string(REPLACE "\n" "\r\n" crlf "${text}")
file(WRITE "${OUTPUT}/item-crlf.txt" "${crlf}")
execute_process(COMMAND "${RULEFORGE}" item "${OUTPUT}/item-crlf.txt" --log-dir "${OUTPUT}/logs" RESULT_VARIABLE result OUTPUT_VARIABLE second ERROR_VARIABLE errors)
if(NOT result EQUAL 0 OR NOT "${second}" STREQUAL "${product}")
    message(FATAL_ERROR "CRLF differs: ${errors}")
endif()
file(WRITE "${OUTPUT}/item-invalid.txt" "not copied item text\n")
execute_process(COMMAND "${RULEFORGE}" item "${OUTPUT}/item-invalid.txt" --log-dir "${OUTPUT}/logs" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE errors)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "invalid copied item text was accepted")
endif()
