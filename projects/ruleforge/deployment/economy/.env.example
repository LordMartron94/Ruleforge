# Keep localhost when using an SSH tunnel; otherwise use server-media's LAN IP.
RULEFORGE_BIND_ADDRESS=127.0.0.1
RULEFORGE_COLLECTION_INTERVAL=4h
RULEFORGE_LEAGUES=auto
RULEFORGE_GAME_VERSION=3.30
RULEFORGE_ECONOMY_IMAGE=ghcr.io/lordmartron94/ruleforge-economy:latest

# Generate with openssl rand -hex 32; keep .env private.
RULEFORGE_HISTORY_TOKEN=

RULEFORGE_LOG_MAX_SIZE=10m
RULEFORGE_LOG_KEEP=5
