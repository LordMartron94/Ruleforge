version 1.0.0;
module std.build;
import std.collections;

/* Summary: whether a base's item class is one used by the build. Use with a configured PoB base dataset. */
export func UsesClass(item record, classes list<string>) -> bool {
    let kind = collections.Get($item, "class");
    return kind != none and collections.Contains($classes, kind);
}

/* Summary: bases of the classes the build uses, retaining their provider metadata. */
export func ForClasses(items any, classes list<string>) -> list<record> {
    var result = [];
    for item in $items {
        if UsesClass(item, $classes) { result = collections.Concat(result, [item]); }
    }
    return result;
}

/* Summary: select a build's weapon classes and armour subtypes from PoB bases.
   Belts are universal; armour membership is explicit. */
export func ForPreset(items any, weapons list<string>, armourTypes list<string>) -> list<record> {
    var selected = [];
    let armour = ["Body Armours", "Boots", "Gloves", "Helmets", "Shields"];
    for item in $items {
        var used = collections.Contains($weapons, item.class);
        if collections.Contains(armour, item.class) {
            let subtype = collections.Get(item, "subType");
            used = subtype != none and collections.Contains($armourTypes, subtype);
        }
        if item.class == "Belts" { used = true; }
        if used { selected = collections.Concat(selected, [item]); }
    }
    return selected;
}
