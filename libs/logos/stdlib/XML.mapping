extensions = xml, xsd, svg, plist, xsl, xslt, rss, atom, wsdl
scope = text.xml

$byte_order_mark = punctuation.definition.bom
$comment_text = comment.block
$comment_dash = comment.block
context COMMENT = comment.block
$comment_open = punctuation.definition.comment.begin
$dtd_comment_open = punctuation.definition.comment.begin
$content_comment_open = punctuation.definition.comment.begin
$comment_close = punctuation.definition.comment.end

$xml_decl_open = meta.preprocessor.xml
$version_key = entity.other.attribute-name
$encoding_key = entity.other.attribute-name
$standalone_key = entity.other.attribute-name
$decl_eq = punctuation.separator.key-value
$version_value = string.quoted
$encoding_value = string.quoted
$standalone_value = string.quoted
$decl_close = meta.preprocessor.xml

$pi_open = meta.preprocessor
$dtd_pi_open = meta.preprocessor
$content_pi_open = meta.preprocessor
$pi_target = entity.name.tag.pi
$pi_data = meta.preprocessor
$pi_question = meta.preprocessor
$pi_close = meta.preprocessor
$pi_end = meta.preprocessor
context PI_DATA = meta.preprocessor

$doctype_open = meta.tag.sgml.doctype
$doctype_gt = meta.tag.sgml.doctype
$dtd_name = entity.name.tag
$system_key = keyword.declaration
$public_key = keyword.declaration
$ndata_key = keyword.declaration
$system_literal = string.quoted
$pubid_literal = string.quoted
$subset_open = punctuation.section.brackets.begin
$subset_close = punctuation.section.brackets.end
$pe_reference = constant.character.entity.parameter
$dtd_percent = keyword.operator

$element_decl_open = keyword.declaration
$attlist_decl_open = keyword.declaration
$entity_decl_open = keyword.declaration
$notation_decl_open = keyword.declaration
$decl_gt = keyword.declaration
$empty_key = constant.language
$any_key = constant.language
$pcdata = constant.language
$cdata_key = storage.type
$id_key = storage.type
$idref_key = storage.type
$idrefs_key = storage.type
$entity_key = storage.type
$entities_key = storage.type
$nmtoken_key = storage.type
$nmtokens_key = storage.type
$notation_key = storage.type
$required_key = constant.language
$implied_key = constant.language
$fixed_key = constant.language
$dtd_lparen = punctuation.section.group.begin
$dtd_rparen = punctuation.section.group.end
$rparen_star = punctuation.section.group.end
$dtd_bar = keyword.operator
$dtd_comma = punctuation.separator
$dtd_question = keyword.operator
$dtd_star = keyword.operator
$dtd_plus = keyword.operator
$enum_lparen = punctuation.section.group.begin
$enum_rparen = punctuation.section.group.end
$enum_token = string.unquoted
$enum_bar = keyword.operator
$notation_lparen = punctuation.section.group.begin
$notation_rparen = punctuation.section.group.end
$notation_name = entity.name
$notation_bar = keyword.operator
$default_value = string.quoted
$entity_value = string.quoted

$start_tag_open = entity.name.tag
$content_start_tag_open = entity.name.tag
$end_tag = entity.name.tag
$attribute_name = entity.other.attribute-name
$tag_eq = punctuation.separator.key-value
$attribute_value = string.quoted
$tag_close = punctuation.definition.tag.end
$empty_tag_close = punctuation.definition.tag.end

$char_reference = constant.character.entity
$entity_reference = constant.character.entity
$cdata_open = punctuation.definition.string.begin
$cdata_close = punctuation.definition.string.end
$cdata_text = string.unquoted.cdata
$cdata_bracket = string.unquoted.cdata
context CDATA = string.unquoted.cdata

rule #element = meta.tag
rule #cdata_section = meta.cdata
rule #comment = comment.block
rule #doctype_decl = meta.tag.sgml.doctype
