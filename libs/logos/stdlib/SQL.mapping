extensions = sql
scope = source.sql

$line_comment = comment.line.double-dash
$block_comment_open = comment.block
$block_comment_close = comment.block
$block_comment_text = comment.block
$block_comment_star = comment.block
context BLOCK_COMMENT = comment.block

$kw_select = keyword.control
$kw_distinct = keyword.control
$kw_from = keyword.control
$kw_where = keyword.control
$kw_group = keyword.control
$kw_by = keyword.control
$kw_having = keyword.control
$kw_order = keyword.control
$kw_limit = keyword.control
$kw_offset = keyword.control
$kw_join = keyword.control
$kw_inner = keyword.control
$kw_left = keyword.control
$kw_right = keyword.control
$kw_full = keyword.control
$kw_outer = keyword.control
$kw_cross = keyword.control
$kw_on = keyword.control
$kw_using = keyword.control
$kw_union = keyword.control
$kw_all = keyword.control
$kw_insert = keyword.control
$kw_into = keyword.control
$kw_values = keyword.control
$kw_update = keyword.control
$kw_set = keyword.control
$kw_delete = keyword.control
$kw_create = keyword.control
$kw_table = keyword.control
$kw_view = keyword.control
$kw_index = keyword.control
$kw_unique = keyword.control
$kw_drop = keyword.control
$kw_alter = keyword.control
$kw_add = keyword.control
$kw_column = keyword.control
$kw_primary = keyword.control
$kw_key = keyword.control
$kw_foreign = keyword.control
$kw_references = keyword.control
$kw_default = keyword.control
$kw_not = keyword.control
$kw_null = keyword.control
$kw_and = keyword.control
$kw_or = keyword.control
$kw_in = keyword.control
$kw_is = keyword.control
$kw_like = keyword.control
$kw_between = keyword.control
$kw_exists = keyword.control
$kw_as = keyword.control
$kw_case = keyword.control
$kw_when = keyword.control
$kw_then = keyword.control
$kw_else = keyword.control
$kw_end = keyword.control
$kw_asc = keyword.control
$kw_desc = keyword.control
$kw_begin = keyword.control
$kw_commit = keyword.control
$kw_rollback = keyword.control
$kw_true = keyword.control
$kw_false = keyword.control

$identifier = variable.other
$quoted_identifier = variable.other
$number = constant.numeric
$string = string.quoted.single
$parameter = variable.parameter
$lparen = punctuation.section.parens.begin
$rparen = punctuation.section.parens.end
$comma = punctuation.separator
$semicolon = punctuation.terminator
$dot = punctuation.accessor
$star = keyword.operator
$operator = keyword.operator
rule #group = meta.group
