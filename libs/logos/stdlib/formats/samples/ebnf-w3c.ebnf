/* JSON in the notation of the W3C: classes, code points, an exception, suffixes and a constraint note. */
json       ::= value
value      ::= object | array | string | number | 'true' | 'false' | 'null'
object     ::= '{' (pair (',' pair)*)? '}'
pair       ::= string ':' value
array      ::= '[' (value (',' value)*)? ']'
string     ::= '"' (StringChar | '\' ["\/bfnrt] | '\u' Hex Hex Hex Hex)* '"'
StringChar ::= Char - ["\]  [ vc: No Control Characters ]
Char       ::= [#x20-#x10FFFF]
Hex        ::= [0-9a-fA-F]
number     ::= '-'? ('0' | [1-9] [0-9]*) ('.' [0-9]+)? ([eE] [+-]? [0-9]+)?
