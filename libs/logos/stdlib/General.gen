Library: General
Version: 1.0.0

/*
Both library and language files support multiline comments.

A library contains templates, enums, and imports, but no directly
instantiated lexer contexts, grammar rules, or Pratt rules.

Template parameters begin with $$. Results are typed:
- LexicalExpression: reusable non-emitting matching language.
- TokenDefinition: an emitting token declared in the caller's context.
- GrammarExpression: an expression used within a grammatical rule.
- PrattEntry: an operator entry used inside a PRATT block.
- RuleDefinition: a complete grammatical or Pratt rule declaration.

Expression templates expose the namesake $_... or #... result defined
inside their body. Declaration templates instead emit the explicitly
named token or rule (for example $$name or PRATT <$$name>).
All additional rules declared inside an expansion are private/hygienic.
*/

// ENUMERATIONS

// Members are qualified, immutable compile-time constants.
// Enums are nominal types, not arbitrary numeric aliases.
ENUM EmptyPolicy {
    ALLOW,
    FORBID
}

ENUM TrailingSeparatorPolicy {
    ALLOW,
    FORBID
}

ENUM SignPolicy {
    NONE,
    OPTIONAL_MINUS,
    OPTIONAL_BOTH
}

// LEXICAL TEMPLATES

// Reusable character and numerical fragments.
TEMPLATE <$_digit>() -> LexicalExpression {
    $_digit = '0'..'9'
}

TEMPLATE <$_nonzero_digit>() -> LexicalExpression {
    $_nonzero_digit = '1'..'9'
}

TEMPLATE <$_hex_digit>() -> LexicalExpression {
    $_hex_digit = $_digit() || 'a'..'f' || 'A'..'F'
}

TEMPLATE <$_oct_digit>() -> LexicalExpression {
    $_oct_digit = '0'..'7'
}

TEMPLATE <$_bin_digit>() -> LexicalExpression {
    $_bin_digit = '0'..'1'
}

TEMPLATE <$_sign>() -> LexicalExpression {
    $_sign = '+' || '-'
}

TEMPLATE <$_letter>() -> LexicalExpression {
    $_letter = 'A'..'Z' || 'a'..'z'
}

// Underscores may only occur between digits.
TEMPLATE <$_decimal_digits>() -> LexicalExpression {
    $_decimal_digits = $_digit() ('_'? $_digit())*
}

TEMPLATE <$_unsigned_decimal>() -> LexicalExpression {
    $_unsigned_decimal = '0' ||
                         $_nonzero_digit() ('_'? $_digit())*
}

TEMPLATE <$_hex_digits>() -> LexicalExpression {
    $_hex_digits = $_hex_digit() ('_'? $_hex_digit())*
}

TEMPLATE <$_oct_digits>() -> LexicalExpression {
    $_oct_digits = $_oct_digit() ('_'? $_oct_digit())*
}

TEMPLATE <$_bin_digits>() -> LexicalExpression {
    $_bin_digits = $_bin_digit() ('_'? $_bin_digit())*
}

// Non-ASCII Unicode scalar values, excluding surrogates.
TEMPLATE <$_non_ascii>() -> LexicalExpression {
    $_non_ascii = '\u{80}'..'\u{D7FF}' ||
                  '\u{E000}'..'\u{10FFFF}'
}

// LF or CRLF, but not an isolated CR.
TEMPLATE <$_newline>() -> LexicalExpression {
    $_newline = '\r\n' || '\n'
}

// SEMANTIC VERSIONING

/*
Semantic Versioning 2.0.0 (https://semver.org), the <valid semver> grammar of its specification, production by production.
A call stands for the text of one version, so a language makes it a token: $version = $_semver().
The specification has no leading "v" and no whitespace: "v1.2.3" and "1.2.3 " are not versions. What a grammar cannot
express is left out: precedence between versions is for the program that compares them.

The specification writes its lists recursively; a lexical expression cannot recurse, so each
<dot-separated ... identifiers> is written as the first identifier followed by ('.' identifier)*, the same language.
<digit>, <positive digit> and <letter> are $_digit, $_nonzero_digit and $_letter above.
*/

// <non-digit> ::= <letter> | "-"
TEMPLATE <$_semver_non_digit>() -> LexicalExpression {
    $_semver_non_digit = $_letter() || '-'
}

// <identifier character> ::= <digit> | <non-digit>
TEMPLATE <$_semver_identifier_character>() -> LexicalExpression {
    $_semver_identifier_character = $_digit() || $_semver_non_digit()
}

// <numeric identifier> ::= "0" | <positive digit> | <positive digit> <digits>
// Zero, or a number without a leading zero.
TEMPLATE <$_semver_numeric_identifier>() -> LexicalExpression {
    $_semver_numeric_identifier = '0' ||
                                  $_nonzero_digit() $_digit()*
}

// <alphanumeric identifier> ::= <non-digit>
//                             | <non-digit> <identifier characters>
//                             | <identifier characters> <non-digit>
//                             | <identifier characters> <non-digit> <identifier characters>
// Identifier characters with at least one non-digit among them: the four alternatives are one language, written here as
// the digits before the first non-digit, that non-digit, and whatever follows.
TEMPLATE <$_semver_alphanumeric_identifier>() -> LexicalExpression {
    $_semver_alphanumeric_identifier = $_digit()* $_semver_non_digit() $_semver_identifier_character()*
}

// <pre-release identifier> ::= <alphanumeric identifier> | <numeric identifier>
TEMPLATE <$_semver_pre_release_identifier>() -> LexicalExpression {
    $_semver_pre_release_identifier = $_semver_alphanumeric_identifier() || $_semver_numeric_identifier()
}

// <build identifier> ::= <alphanumeric identifier> | <digits>
// Unlike a pre-release identifier, a build identifier of digits may have leading zeros.
TEMPLATE <$_semver_build_identifier>() -> LexicalExpression {
    $_semver_build_identifier = $_semver_alphanumeric_identifier() || $_digit()+
}

// <pre-release> ::= <dot-separated pre-release identifiers>
TEMPLATE <$_semver_pre_release>() -> LexicalExpression {
    $_semver_pre_release = $_semver_pre_release_identifier() ('.' $_semver_pre_release_identifier())*
}

// <build> ::= <dot-separated build identifiers>
TEMPLATE <$_semver_build>() -> LexicalExpression {
    $_semver_build = $_semver_build_identifier() ('.' $_semver_build_identifier())*
}

// <version core> ::= <major> "." <minor> "." <patch>, each a <numeric identifier>
TEMPLATE <$_semver_core>() -> LexicalExpression {
    $_semver_core = $_semver_numeric_identifier() '.' $_semver_numeric_identifier() '.' $_semver_numeric_identifier()
}

// <valid semver> ::= <version core>
//                  | <version core> "-" <pre-release>
//                  | <version core> "+" <build>
//                  | <version core> "-" <pre-release> "+" <build>
TEMPLATE <$_semver>() -> LexicalExpression {
    $_semver = $_semver_core() ('-' $_semver_pre_release())? ('+' $_semver_build())?
}

// Conditional expansion uses strongly typed compile-time enums.
// The absent @if branch emits no lexical prefix.
TEMPLATE <$_integer>(
    $$sign: SignPolicy = SignPolicy.OPTIONAL_MINUS
) -> LexicalExpression {
    $_integer =
        @if ($$sign == SignPolicy.OPTIONAL_MINUS) {
            '-'?
        }
        @else if ($$sign == SignPolicy.OPTIONAL_BOTH) {
            $_sign()?
        }
        $_unsigned_decimal()
}

// Generates a named emitting token, not a standalone library rule.
// Its context and declaration position belong to the caller.
TEMPLATE <$keyword>(
    $$name: TokenName,
    $$text: string,
    $$priority: int = 0
) -> TokenDefinition {
    $$name = $$text @priority($$priority)
}

// GRAMMATICAL TEMPLATES

/*
Optional local trivia enables JSON-like and TOML-like containers
without granting newlines/comments global permission.

trivia: none        -> only caller-supplied global trivia applies.
trivia: #some_unit  -> zero or more matching units at the designated
                      container boundaries and around separators.

The supplied unit MUST be non-nullable; never pass #trivia* or an
already-optional rule. The unit's matches remain in the lossless CST.

A generated #gap is allowed to be empty, but no repetition directly
repeats #gap alone. The #items repetition progresses through a
separator and a non-nullable element. A template invocation fails
validation if its element or separator violates this progress rule.
*/

TEMPLATE <#sequence>(
    $$element: Token | Expression,
    $$separator: Token,
    $$empty: EmptyPolicy = EmptyPolicy.ALLOW,
    $$trailing: TrailingSeparatorPolicy = TrailingSeparatorPolicy.FORBID,
    $$trivia: Expression? = none
) -> GrammarExpression {
    // Empty when no explicit trivia is configured.
    #gap = @if ($$trivia != none) {
        $$trivia*
    }

    #items =
        $$element
        (#gap $$separator #gap $$element)*
        @if ($$trailing == TrailingSeparatorPolicy.ALLOW) {
            (#gap $$separator)?
        }

    #sequence =
        #gap
        @if ($$empty == EmptyPolicy.ALLOW) {
            #items?
        }
        @else {
            #items
        }
        #gap
}

// Add delimiters around a configurable sequence.
TEMPLATE <#delimited>(
    $$open_token: Token,
    $$close_token: Token,
    $$element: Token | Expression,
    $$separator: Token,
    $$empty: EmptyPolicy = EmptyPolicy.ALLOW,
    $$trailing: TrailingSeparatorPolicy = TrailingSeparatorPolicy.FORBID,
    $$trivia: Expression? = none
) -> GrammarExpression {
    #delimited =
        $$open_token
        #sequence(
            element: $$element,
            separator: $$separator,
            empty: $$empty,
            trailing: $$trailing,
            trivia: $$trivia
        )
        $$close_token
}

// Compose a pair and forward all container policies, including trivia.
TEMPLATE <#dictionary>(
    $$open_token: Token,
    $$close_token: Token,
    $$key: Token | Expression,
    $$value: Token | Expression,
    $$assignment: Token,
    $$separator: Token,
    $$empty: EmptyPolicy = EmptyPolicy.ALLOW,
    $$trailing: TrailingSeparatorPolicy = TrailingSeparatorPolicy.FORBID,
    $$trivia: Expression? = none
) -> GrammarExpression {
    #pair = $$key $$assignment $$value

    #dictionary = #delimited(
        open_token: $$open_token,
        close_token: $$close_token,
        element: #pair,
        separator: $$separator,
        empty: $$empty,
        trailing: $$trailing,
        trivia: $$trivia
    )
}

// PRATT TEMPLATES

/*
Pratt operators are grammatical entries, not lexer actions.

All binding powers are explicit integer values. There are no
precedence keywords or associativity keywords:
- infix left_bp = 30, right_bp = 31 -> left associative
- infix left_bp = 80, right_bp = 80 -> right associative
- prefix right_bp = 65              -> operand parses at 65
- postfix left_bp = 90              -> binds when min_bp <= 90

Higher powers bind more tightly. Lexical @priority is unrelated.
The library can generate entries and entire Pratt rules, but may
not declare a standalone Pratt rule outside a template.
*/

TEMPLATE <#pratt_prefix>(
    $$operator: Token,
    $$right_bp: int
) -> PrattEntry {
    prefix $$operator (right_bp: $$right_bp)
}

TEMPLATE <#pratt_infix>(
    $$operator: Token,
    $$left_bp: int,
    $$right_bp: int
) -> PrattEntry {
    infix $$operator (left_bp: $$left_bp, right_bp: $$right_bp)
}

TEMPLATE <#pratt_postfix>(
    $$operator: Token,
    $$left_bp: int
) -> PrattEntry {
    postfix $$operator (left_bp: $$left_bp)
}

// A reusable Pratt rule generator. All binding powers can be
// overridden by a consuming language or another library.
// The generated PRATT rule exists only at the instantiation site.
TEMPLATE <#arithmetic_pratt>(
    $$name: RuleName,
    $$atom: Expression,
    $$minus: Token,
    $$plus: Token,
    $$multiply: Token,
    $$power: Token,
    $$factorial: Token,
    $$prefix_right_bp: int = 65,
    $$plus_left_bp: int = 30,
    $$plus_right_bp: int = 31,
    $$multiply_left_bp: int = 50,
    $$multiply_right_bp: int = 51,
    $$power_left_bp: int = 80,
    $$power_right_bp: int = 80,
    $$factorial_left_bp: int = 90
) -> RuleDefinition {
    PRATT <$$name> {
        atom = $$atom

        #pratt_prefix(operator: $$minus, right_bp: $$prefix_right_bp)
        #pratt_infix(operator: $$plus,
                     left_bp: $$plus_left_bp,
                     right_bp: $$plus_right_bp)
        #pratt_infix(operator: $$multiply,
                     left_bp: $$multiply_left_bp,
                     right_bp: $$multiply_right_bp)
        #pratt_infix(operator: $$power,
                     left_bp: $$power_left_bp,
                     right_bp: $$power_right_bp)
        #pratt_postfix(operator: $$factorial,
                       left_bp: $$factorial_left_bp)
    }
}

// CHOICE TEMPLATES

/*
ChoiceMode is a Genesis built-in nominal enum, available to all source units.
The selected policy affects only this generated alternative group.
Neither this template nor grammar-level choice changes lexical token priority.
*/
TEMPLATE <#choice_pair>(
    $$first: Expression,
    $$second: Expression,
    $$mode: ChoiceMode = ChoiceMode.ORDERED
) -> GrammarExpression {
    #choice_pair = ($$first || $$second) @choice($$mode)
}

// EMBEDDING TEMPLATES

/*
EMBED generates a grammatical rule, not lexer actions. Both lexer stacks
remain private. Host opener/closer tokens retain ownership of transitions.
LanguageRef and RuleRef are compile-time references to imported grammars.
*/
ENUM EmbeddedBoundary {
    ANY,
    LINE_START
}

TEMPLATE <#embedded_region>(
    $$name: RuleName,
    $$language: LanguageRef,
    $$entry: RuleRef,
    $$open: Token,
    $$close: Token,
    $$close_boundary: EmbeddedBoundary = EmbeddedBoundary.ANY
) -> RuleDefinition {
    EMBED <$$name> {
        mode = region
        language = $$language
        entry = $$entry
        open = $$open
        close = $$close
        close_boundary = $$close_boundary
        content = raw
    }
}

/*
This form parses the interior bytes of one already-emitted host token.
The guest tree is an overlay; the host token remains the sole byte owner.
Offsets are byte counts, not Unicode code-point counts.
*/
TEMPLATE <#embedded_token>(
    $$name: RuleName,
    $$language: LanguageRef,
    $$entry: RuleRef,
    $$source: Token,
    $$prefix_bytes: uint,
    $$suffix_bytes: uint
) -> RuleDefinition {
    EMBED <$$name> {
        mode = token
        language = $$language
        entry = $$entry
        source = $$source
        content = inner_bytes($$prefix_bytes, $$suffix_bytes)
    }
}
