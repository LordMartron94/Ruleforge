      scope: keyword.declaration.namespace.genesis
    - match: '(?:PARSER)(?![A-Za-z0-9_])'
      scope: keyword.declaration.struct.genesis
    - match: '(?:prefix)(?![A-Za-z0-9_])'
      scope: keyword.other.genesis
    - match: '(?:PRATT)(?![A-Za-z0-9_])'
      scope: keyword.declaration.struct.genesis
    - match: '(?:EMBED)(?![A-Za-z0-9_])'
      scope: keyword.declaration.struct.genesis
    - match: '(?:infix)(?![A-Za-z0-9_])'
      scope: keyword.other.genesis
    - match: '(?:\@else)(?![A-Za-z0-9_])'
      scope: keyword.control.conditional.genesis
    - match: '(?:\@prec)(?![A-Za-z0-9_])'
      scope: entity.other.attribute-name.genesis
    - match: '(?:ENUM)(?![A-Za-z0-9_])'
      scope: keyword.declaration.enum.genesis
    - match: '(?:atom)(?![A-Za-z0-9_])'
      scope: keyword.other.genesis
    - match: '(?:push)(?![A-Za-z0-9_])'
      scope: keyword.control.genesis
    - match: '(?:none)(?![A-Za-z0-9_])'
      scope: constant.language.genesis
    - match: '(?:pop)(?![A-Za-z0-9_])'
      scope: keyword.control.genesis
    - match: '(?:set)(?![A-Za-z0-9_])'
      scope: keyword.control.genesis
    - match: '(?:\@if)(?![A-Za-z0-9_])'
      scope: keyword.control.conditional.genesis
    - match: '(?:AS)(?![A-Za-z0-9_])'
      scope: keyword.declaration.namespace.genesis
    - match: '(?:\-\>)'
      scope: keyword.operator.arrow.genesis
    - match: '(?:\=\=)'
      scope: keyword.operator.comparison.genesis
    - match: '(?:\!\=)'
      scope: keyword.operator.comparison.genesis
    - match: '(?:\.\.)'
      scope: keyword.operator.range.genesis
    - match: '(?:\|\|)'
      scope: keyword.operator.alternation.genesis
    - match: '(?:\/\*)'
      scope: comment.block.genesis
      push: BLOCK_COMMENT
    - match: '\{'
      scope: punctuation.section.braces.begin.genesis
      push: frame-braces
    - match: '\('
      scope: punctuation.section.parens.begin.genesis
      push: frame-parens
    - match: '\<'
      scope: punctuation.section.angles.begin.genesis
      push: frame-angles
    - match: '\['
      scope: punctuation.section.brackets.begin.genesis
      push: frame-brackets
    - match: '\='
      scope: keyword.operator.assignment.genesis
    - match: '\?'
      scope: keyword.operator.optional.genesis
    - match: '\*'
      scope: keyword.operator.star.genesis
    - match: '\+'
      scope: keyword.operator.plus.genesis
    - match: '\-'
      scope: keyword.operator.minus.genesis
    - match: '\.'
      scope: keyword.operator.wildcard.genesis
    - match: '\|'
      scope: keyword.operator.alternation.genesis
    - match: '\!'
      scope: keyword.operator.negation.genesis
    - match: '\:'
      scope: punctuation.separator.genesis
    - match: '\,'
      scope: punctuation.separator.genesis
    - match: '\]'
      scope: punctuation.section.brackets.end.genesis
      pop: true
    - match: '(?:\@[A-Z_a-z][0-9A-Z_a-z]*)'
      scope: entity.other.attribute-name.genesis
    - match: '(?:[A-Z_a-z][0-9A-Z_a-z]*)'
      scope: variable.other.genesis
    - match: '(?:(?:\$\$)[A-Z_a-z][0-9A-Z_a-z]*)'
      scope: variable.parameter.genesis
    - match: '(?:(?:\$_)[0-9A-Z_a-z]*)'
      scope: support.constant.fragment.genesis
    - match: '(?:\$[A-Z_a-z][0-9A-Z_a-z]*)'
      scope: support.constant.genesis
    - match: '(?:\#[A-Z_a-z][0-9A-Z_a-z]*)'
      scope: entity.name.function.genesis
    - match: '(?:\''(?:\x{9}|[ -\&]|[\(-\[]|[\]-\x{10FFFF}]|(?:\\[ -\x{10FFFF}]))*\'')'
      scope: string.quoted.single.genesis
    - match: '(?:\"(?:\x{9}|[ -\!]|[\#-\[]|[\]-\x{10FFFF}]|(?:\\[ -\x{10FFFF}]))*\")'
      scope: string.quoted.double.genesis
    - match: '[0-9]+'
      scope: constant.numeric.genesis
    - match: '[\x{9}-\x{A}\x{D} ]+'
    - match: '(?:(?:\/\/)[\x{9} -\x{10FFFF}]*)'
      scope: comment.line.double-slash.genesis
  BLOCK_COMMENT:
    - meta_scope: comment.block.genesis
    - match: '(?:\*\/)'
      scope: comment.block.genesis
      pop: true
    - match: '\*'
      scope: comment.block.genesis
    - match: '[\x{0}-\)\+-\x{10FFFF}]+'
      scope: comment.block.genesis
