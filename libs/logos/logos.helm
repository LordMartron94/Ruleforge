entity logos {
    kind = "lib"
    use c_shared_library {
        params {
            SOURCE_FILES = [
                glob("src", include="**/*.c", recursive=true),
            ]
            OUT_NAME = "logos"
            CPPFLAGS = [ "-I.", "-Isrc" ]
            COMPILER_FLAGS = LIBRARY_COMPILER_FLAGS
        }
    }

    interface {
        INCLUDE_PATHS = [ rel(".") ]
        LDFLAGS = [ "-llogos" ]
    }

    deps = [ "//libs/nexus:nexus", "//libs/echo:echo", "//libs/pharos:pharos" ]
}
