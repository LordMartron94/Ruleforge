{
	"folders": [
		{
			"path": "."
		}
	],
	"build_systems": [
		{
			"name": "Ruleforge Project",
			"working_dir": "${project_path}",
			"env": {
				"GOFLAGS": "-mod=vendor",
			},
			"variants": [
				{
					"name": "Run PoB",
					"working_dir": "${project_path}/tools/pob",
					"cmd": [
						"${project_path}/tools/pob/runtime/Path{space}of{space}Building.exe"
					],
					"linux": {
						"cmd": [
							"wine",
							"${project_path}/tools/pob/runtime/Path{space}of{space}Building.exe"
						]
					}
				},
				{
					"name": "Run (Default)",
					"shell_cmd": "./run.sh --config=config.toml",
					"working_dir": "${project_path}",
					"target": "terminus_exec",
					"cancel": "terminus_cancel_build",
				},
				{
					"name": "Run + Open Studio",
					"shell_cmd": "./run.sh --config=config.toml && xdg-open __output__/ruleforge-studio.html",
					"windows": {
						"shell_cmd": "go build -o build\\ruleforge.exe .\\ruleforge\\components\\ruleforge\\entry && build\\ruleforge.exe -config config.toml && start \"\" __output__\\ruleforge-studio.html",
					},
					"osx": {
						"shell_cmd": "./run.sh --config=config.toml && open __output__/ruleforge-studio.html",
					},
					"working_dir": "${project_path}",
					"target": "terminus_exec",
					"cancel": "terminus_cancel_build",
				},
				{
					"name": "Open Studio (last compile)",
					"shell_cmd": "xdg-open __output__/ruleforge-studio.html",
					"windows": {
						"shell_cmd": "start \"\" __output__\\ruleforge-studio.html",
					},
					"osx": {
						"shell_cmd": "open __output__/ruleforge-studio.html",
					},
					"working_dir": "${project_path}",
				},
				{
					"name": "Run (Verbose)",
					"shell_cmd": "./run.sh --verbose",
					"working_dir": "${project_path}",
					"target": "terminus_exec",
					"cancel": "terminus_cancel_build",
				},
				{
					"name": "Run (Update Cache Only)",
					"shell_cmd": "./run.sh --update-cache-only",
					"working_dir": "${project_path}",
					"target": "terminus_exec",
					"cancel": "terminus_cancel_build",
				},
				{
					"name": "Run (Dev Config + Verbose)",
					"shell_cmd": "./run.sh --config=config.toml --verbose",
					"working_dir": "${project_path}",
					"target": "terminus_exec",
					"cancel": "terminus_cancel_build",
				},
				{
					"name": "Run Project Analysis",
					"shell_cmd": "./run_analyzer.sh",
					"working_dir": "${project_path}",
					"target": "terminus_exec",
					"cancel": "terminus_cancel_build",
				},
				{
					"name": "Refresh Vendor",
					"target": "terminus_exec",
					"cancel": "terminus_cancel_build",
					"shell_cmd": "./refresh_vendor.sh",
					"working_dir": "${project_path}",
					"quiet": false,
				},
				{
					"name": "Add Module",
					"target": "terminus_exec",
					"cancel": "terminus_cancel_build",
					"shell_cmd": "./add_module.sh",
					"working_dir": "${project_path}",
					"quiet": false,
				},
			]
		}
	]
}