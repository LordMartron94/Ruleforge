!! MartronArada campaign filter
!!
!! This first version is deliberately permissive. High-value and specialised
!! drops are styled first, while campaign equipment and flasks are generated
!! near the bottom. Anything not matched remains visible through Ruleforge's
!! generated fallback rule.

METADATA {
  NAME       => "MartronAradaCampaign"
  VERSION    => "0.5.0"
  STRICTNESS => ALL
  BUILD      => "MartronArada"
}

!! Campaign progression styles
var equipment_normal     => "Final/Equipment/Normal"
var equipment_magic      => "Final/Equipment/Magic"
var equipment_rare       => "Final/Equipment/Rare"
var equipment_max_rolled => "Final/Equipment/MaxRolled"

var old_equipment_normal => "Final/OldEquipment/Normal"
var old_equipment_magic  => "Final/OldEquipment/Magic"
var old_equipment_rare   => "Final/OldEquipment/Rare"

var flask_current => "Final/Flasks"
var flask_old     => "Final/OldFlasks"

SECTION {
  METADATA {
    NAME        => "Tinctures"
    DESCRIPTION => "Hide every tincture"
  }

  SECTION_CONDITIONS {
  }

  RULES {
    WHERE @item_class == "Tinctures" => $old_equipment_normal => $Hide
  }
}

SECTION {
  METADATA {
    NAME        => "Uniques"
    DESCRIPTION => "Economy tiered unique items"
  }

  SECTION_CONDITIONS {
  }

  RULES {
    MACRO["unique_tiering"
      -> $tier_0 => "Final/Uniques/T0"
      -> $tier_1 => "Final/Uniques/T1"
      -> $tier_2 => "Final/Uniques/T2"
      -> $tier_3 => "Final/Uniques/T3"
      -> $tier_4 => "Final/Uniques/T4"
    ]
  }
}

SECTION {
  METADATA {
    NAME        => "Rare Amulets"
    DESCRIPTION => "Always show rare amulets"
  }

  SECTION_CONDITIONS {
  }

  RULES {
    !! Amulets have one of the widest modifier pools, so any rare one can be
    !! worth reading. No area limit, and early in the file so no later hide
    !! rule can reach them. A corruption implicit takes the border.
    WHERE @corrupted_mods >= 1 -> @item_class == "Amulets" -> @rarity == "Rare" => "Final/Equipment/Corrupted" => $Show
    WHERE @item_class == "Amulets" -> @rarity == "Rare" => "Final/Jewelry/Rare" => $Show
  }
}

SECTION {
  METADATA {
    NAME        => "Gems"
    DESCRIPTION => "Economy tiered and quality gems"
  }

  SECTION_CONDITIONS {
  }

  RULES {
    !! Text, size, beam, minimap and sound always keep the economy tier.
    !! Quality contributes only a border. A tier-specific border (radiance)
    !! wins over Vaal, which wins over quality. The item name and quality
    !! remain readable even when a higher-priority border takes the channel.
    MACRO["skill_gem_tiering"
      -> $tier_1 => "Final/Gems/T1"
      -> $tier_2 => "Final/Gems/T2"
      -> $tier_3 => "Final/Gems/T3"
      -> $tier_4 => "Final/Gems/T4"
      -> $tier_5 => "Final/Gems/T5"
      -> $tier_6 => "Final/Gems/T6"
      -> $tier_7 => "Final/Gems/T7"
      -> $quality_20 => "Final/Special/Quality/Gems/Max"
      -> $quality_10 => "Final/Special/Quality/Gems/Mid"
      -> $quality_1  => "Final/Special/Quality/Gems/Low"
      -> $vaal       => "Final/Special/Vaal"
    ]
  }
}

SECTION {
  METADATA {
    NAME        => "League Mechanics"
    DESCRIPTION => "Configured league mechanic drops"
  }

  SECTION_CONDITIONS {
  }

  RULES {
    !! Curse of the Allflame (3.29) and forward-compatible class fallbacks.
    MACRO["handle_csv" -> $category => "Charts"]
    MACRO["handle_csv" -> $category => "Ducats"]
    MACRO["handle_csv" -> $category => "Allflame"]
    MACRO["handle_csv" -> $category => "Allflame Embers"]
    MACRO["handle_csv" -> $category => "Enshrouding Crystals"]
    MACRO["handle_csv" -> $category => "Mercenaries"]

    !! Mirage (3.28) and Keepers (3.27) items that remain obtainable.
    MACRO["handle_csv" -> $category => "Mirage"]
    MACRO["handle_csv" -> $category => "Astrolabes"]
    MACRO["handle_csv" -> $category => "Runegrafts"]
    MACRO["handle_csv" -> $category => "Keepers"]

    MACRO["handle_csv" -> $category => "Essences"]
    MACRO["handle_csv" -> $category => "Oils"]
    MACRO["handle_csv" -> $category => "Catalysts"]
    MACRO["handle_csv" -> $category => "Breach"]
    MACRO["handle_csv" -> $category => "Delve"]
    MACRO["handle_csv" -> $category => "Expedition"]
    MACRO["handle_csv" -> $category => "Harvest"]
    MACRO["handle_csv" -> $category => "Heist"]
    MACRO["handle_csv" -> $category => "Incursion"]
    MACRO["handle_csv" -> $category => "Eldritch"]

    !! A Stacked Deck opens into a random divination card, so it wears the
    !! card look; at about six chaos it ranks with T4 cards.
    MACRO["handle_csv" -> $category => "Divination"]
    MACRO["divination_card_tiering"
      -> $tier_0 => "Final/Divination/T0"
      -> $tier_1 => "Final/Divination/T1"
      -> $tier_2 => "Final/Divination/T2"
      -> $tier_3 => "Final/Divination/T3"
      -> $tier_4 => "Final/Divination/T4"
      -> $tier_5 => "Final/Divination/T5"
      -> $tier_6 => "Final/Divination/T6"
    ]

    !! Tattoos swing from fractions of a chaos to divines and follow the build
    !! meta, so they are tiered by price like divination cards. A tattoo with
    !! no price is a rare reward (Honoured, Loyalty and most Journey tattoos).
    MACRO["tattoo_tiering"
      -> $tier_1   => "Final/Tattoos/T1"
      -> $tier_2   => "Final/Tattoos/T2"
      -> $tier_3   => "Final/Tattoos/T3"
      -> $tier_4   => "Final/Tattoos/T4"
      -> $tier_5   => "Final/Tattoos/T5"
      -> $tier_6   => "Final/Tattoos/T6"
      -> $fallback => "Final/Tattoos/Unpriced"
    ]
    MACRO["handle_csv" -> $category => "Map Fragments"]
    MACRO["handle_csv" -> $category => "Scarabs"]

    !! Hidden item state is less visible than sockets in the drop label, so
    !! these property marks must precede the secondary link/socket section.
    MACRO["veiled" -> $style => "Final/Equipment/Veiled"]
    WHERE @fractured == "True" => "Final/Equipment/Fractured" => $Show
  }
}

SECTION {
  METADATA {
    NAME        => "Corruption Implicits"
    DESCRIPTION => "Corrupted gear and jewels whose corruption added an implicit"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
  }

  RULES {
    !! Corruption on its own is no reason to show an item: it only takes away
    !! crafting, recolouring and linking. What it can add is an implicit
    !! (+1 to socketed gems, life, resistances, aura effect), so only items
    !! with one get the corrupted border: rares the build can wear (belts
    !! included), rare rings, and magic or rare jewels. Every other corrupted
    !! item is judged like any other drop further down.
    WHERE @corrupted_mods >= 1 -> @rarity == "Rare" -> @class_use == "true" => "Final/Equipment/Corrupted" => $Show
    WHERE @corrupted_mods >= 1 -> @rarity == "Rare" -> @item_class == "Rings" => "Final/Equipment/Corrupted" => $Show
    WHERE @corrupted_mods >= 1 -> @item_class == "Jewels" => "Final/Equipment/Corrupted" => $Show
  }
}

SECTION {
  METADATA {
    NAME        => "Gold"
    DESCRIPTION => "Gold stacks for campaign and league mechanics"
  }

  SECTION_CONDITIONS {
  }

  RULES {
    WHERE @item_type == "Gold" -> @stack_size >= 1000 => "Final/Leagues/Gold_High" => $Show
    WHERE @item_type == "Gold" -> @stack_size >= 250 => "Final/Leagues/Gold_Mid" => $Show
    WHERE @item_type == "Gold" => "Final/Leagues/Gold_Low" => $Show
  }
}

SECTION {
  METADATA {
    NAME        => "Currency and Supplies"
    DESCRIPTION => "Campaign currency and utility supplies"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
  }

  RULES {
    MACRO["handle_csv" -> $category => "Orbs"]
    MACRO["handle_csv" -> $category => "Supplies"]

    !! Supplemental coverage for mapping supplies encountered before maps,
    !! including reward/manual drops. Earlier campaign tiers win overlaps.
    !! Scouting Reports are legacy (removed in 3.28); their presence in the
    !! Studio is synthetic and does not establish a current drop source.
    !! Orb of Unmaking has natural drop level 70. These rules style items
    !! on the ground; they intentionally do not impose acquisition rules.
    MACRO["handle_csv" -> $category => "Orbs-Mapping"]
    MACRO["handle_csv" -> $category => "Supplies-Mapping"]
  }
}

SECTION {
  METADATA {
    NAME        => "Campaign Map Finds"
    DESCRIPTION => "Maps found before entering the Atlas"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
    WHERE @item_class == "Maps"
  }

  RULES {
    !! First maps drop during the campaign. Keep this permissive regardless
    !! of map tier so reward/manual drops are also visible. This does not
    !! add any rules for mapping areas. Economy-tiered uniques still win.
    WHERE @rarity == "Unique" => "Final/Maps/UniqueMaps" => $Show
    WHERE @rarity == "Rare" => "Final/Maps/LowTierRareT1T2" => $Show
    WHERE @rarity == "Magic" => "Final/Maps/LowTierMagicT1T2" => $Show
    WHERE @rarity == "Normal" => "Final/Maps/LowTierNormalT1T2" => $Show
  }
}

SECTION {
  METADATA {
    NAME        => "Max-Roll Precedence"
    DESCRIPTION => "Shown max-rolled armour takes the max-roll look"
  }

  SECTION_CONDITIONS {
  }

  RULES {
    !! A max-rolled base is not visible in the ground label, so it outranks
    !! the properties that are (links, sockets) and crafting eligibility.
    !! This shows nothing by itself: every later Show rule that could match
    !! armour gets a max-roll copy placed just before it, so an item is only
    !! restyled when a rule already shows it. Hide rules get no copy. The copy
    !! keeps the rule's purpose (background, icon shape), takes the max-roll
    !! border, and takes the higher of the two priority tiers.
    MACRO["max_roll_precedence" -> $style => $equipment_max_rolled]
  }
}

SECTION {
  METADATA {
    NAME        => "Crafting Bases"
    DESCRIPTION => "Normal and magic bases worth crafting on for any class"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
    WHERE @corrupted == "False"
  }

  RULES {
    !! The "Crafting Bases" CSV category lists bases for every class, since
    !! they also gear future characters. A base qualifies through its
    !! implicit (resistance, life and attribute jewellery, +2% maximum
    !! resistance rings, +1 gem crowns, block gloves, suppression and
    !! movement speed shields), by being the strongest base of its weapon
    !! or defence type, or as a vendor recipe input (Rustic Sash, elemental
    !! rings). Bases above drop level 67 cannot drop in the campaign; they
    !! are listed for a later mapping section.
    !!
    !! Placed before the secondary link/socket section so the forge field
    !! remains the winning look for a qualifying base; a max-rolled base
    !! keeps the forge field but takes the max-roll border.
    MACRO["handle_csv" -> $category => "Crafting Bases"]
  }
}

SECTION {
  METADATA {
    NAME        => "Links and Sockets"
    DESCRIPTION => "Secondary styling for visible links sockets and trichromatic items"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
  }

  RULES {
    !! Socket and link layouts are already visible on the item label. Keep
    !! their styling secondary: 3/4-link and RGB marks are quiet, 5/6-link
    !! and 5/6-socket marks retain a border, and hidden item state (fractured,
    !! corruption implicits, veiled, max-roll and quality where applicable)
    !! wins first. These layouts keep their worth on corrupted gear too: a
    !! 5/6-link can still be worn, and 6-socket and RGB items vendor for
    !! currency.
    WHERE @socket_group >= "6" => "Final/Special/Sockets/6-link" => $Show
    WHERE @socket_group >= "5" => "Final/Special/Sockets/5-link" => $Show
    WHERE @socket_group >= "4RGB" -> @height == 2 -> @width == 2 => "Final/Special/RGB-4-socket" => $Show
    WHERE @socket_group == "RGB" -> @height == 1 -> @width == 3 => "Final/Special/RGB" => $Show
    WHERE @socket_group == "RGB" -> @height == 3 -> @width == 1 => "Final/Special/RGB" => $Show
    WHERE @socket_group == "RGB" -> @height == 2 -> @width == 2 => "Final/Special/RGB" => $Show
    WHERE @sockets >= "6" => "Final/Special/Sockets/6-socket" => $Show
  }
}

SECTION {
  METADATA {
    NAME        => "Corrupted Gear"
    DESCRIPTION => "Hide corrupted normal and magic gear"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
    WHERE @corrupted == "True"
  }

  RULES {
    !! Normal and magic gear is worth picking up in the campaign for what can
    !! still be done to it: alchemy, crafting, recolouring and linking.
    !! Corruption rules all of that out, so these hides come before the
    !! socket reminders and progression rules that would otherwise show it.
    !! Flasks and jewels are left to their own rules.
    WHERE @rarity == "Normal" -> @class_use == "true" => $old_equipment_normal => $Hide
    WHERE @rarity == "Normal" -> @class_use == "false" => $old_equipment_normal => $Hide
    WHERE @rarity == "Normal" -> @item_class == "Rings" => $old_equipment_normal => $Hide
    WHERE @rarity == "Normal" -> @item_class == "Amulets" => $old_equipment_normal => $Hide
    WHERE @rarity == "Magic" -> @class_use == "true" => $old_equipment_magic => $Hide
    WHERE @rarity == "Magic" -> @class_use == "false" => $old_equipment_magic => $Hide
    WHERE @rarity == "Magic" -> @item_class == "Rings" => $old_equipment_magic => $Hide
    WHERE @rarity == "Magic" -> @item_class == "Amulets" => $old_equipment_magic => $Hide
  }
}

SECTION {
  METADATA {
    NAME        => "Link Reminders"
    DESCRIPTION => "Sockets worth linking or recolouring for the build"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
  }

  RULES {
    WHERE @sockets >= "5" => "Final/Special/Sockets/5-socket" => $Show
    WHERE @socket_group >= "4" -> @class_use == "true" => "Final/Special/Sockets/4-link" => $Show
    WHERE @area_level <= 40 -> @sockets >= "4" -> @class_use == "true" => "Final/Special/Sockets/4-socket" => $Show
    WHERE @area_level <= 24 -> @socket_group >= "3" -> @class_use == "true" => "Final/Special/Sockets/3-link" => $Show
  }
}

SECTION {
  METADATA {
    NAME        => "Off-Class Links"
    DESCRIPTION => "Hide off-class linked and socketed gear"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
  }

  RULES {
    !! Off-class items with the same link/socket counts keep the identical
    !! style, just hidden instead of shown: PoE still renders MinimapIcon and
    !! PlayEffect on Hide blocks, so the minimap ping survives even though the
    !! on-ground text/border doesn't - better than losing the signal entirely
    !! by falling through to a generic hide rule further down.
    WHERE @socket_group >= "6" -> @class_use == "false" => "Final/Special/Sockets/6-link" => $Hide
    WHERE @socket_group >= "5" -> @class_use == "false" => "Final/Special/Sockets/5-link" => $Hide
    WHERE @socket_group >= "4" -> @class_use == "false" => "Final/Special/Sockets/4-link" => $Hide
    WHERE @area_level <= 40 -> @sockets >= "6" -> @class_use == "false" => "Final/Special/Sockets/6-socket" => $Hide
    WHERE @area_level <= 40 -> @sockets >= "5" -> @class_use == "false" => "Final/Special/Sockets/5-socket" => $Hide
    WHERE @area_level <= 40 -> @sockets >= "4" -> @class_use == "false" => "Final/Special/Sockets/4-socket" => $Hide
    WHERE @area_level <= 24 -> @socket_group >= "3" -> @class_use == "false" => "Final/Special/Sockets/3-link" => $Hide
  }
}

SECTION {
  METADATA {
    NAME        => "Campaign Jewelry"
    DESCRIPTION => "Visible campaign jewelry and jewels"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
  }

  RULES {
    WHERE @item_class == "Rings" -> @rarity == "Rare" => "Final/Jewelry/Rare" => $Show
    WHERE @item_class == "Rings" -> @rarity == "Magic" => "Final/Jewelry/Magic" => $Show
    WHERE @item_class == "Amulets" -> @rarity == "Magic" => "Final/Jewelry/Magic" => $Show
    WHERE @item_class == "Rings" -> @rarity == "Normal" => "Final/Jewelry/Normal" => $Show
    WHERE @item_class == "Amulets" -> @rarity == "Normal" => "Final/Jewelry/Normal" => $Show
    WHERE @item_class == "Jewels" => "Final/Jewels" => $Show
  }
}

SECTION {
  METADATA {
    NAME        => "Labyrinth"
    DESCRIPTION => "Labyrinth keys and Izaro-fight trinkets"
  }

  SECTION_CONDITIONS {
  }

  RULES {
    !! Labyrinth Items = the Silver/Ornate/Gold reliquary keys; Labyrinth
    !! Trinkets = the consumables that help against Izaro. The real filter
    !! classes are plural (verified against NeverSink's filter, since the
    !! game rejected the singular "Labyrinth Item"/"Labyrinth Trinket" with
    !! "No item classes found exactly matching"). Neither has meaningful
    !! named variants worth tiering, so a plain class match covers each
    !! (hand-written WHERE conditions only take one value each - multi-value
    !! lists are a macro-only feature - so this needs two lines).
    WHERE @item_class == "Labyrinth Items" => "Final/Lab" => $Show
    WHERE @item_class == "Labyrinth Trinkets" => "Final/Lab" => $Show
  }
}

SECTION {
  METADATA {
    NAME        => "Small Campaign Rares"
    DESCRIPTION => "Compact rare items to sell for useful shards"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
    WHERE @rarity == "Rare"
  }

  RULES {
    !! Match before equipment progression and class-use rules so outdated or
    !! off-build rares remain visible. Use the compact vendor-item footprints.
    WHERE @height <= 2 -> @width <= 2 => $equipment_rare => $Show
    WHERE @height <= 3 -> @width == 1 => $equipment_rare => $Show
    WHERE @height == 1 -> @width <= 3 => $equipment_rare => $Show
  }
}

SECTION {
  METADATA {
    NAME        => "Normal Gear Cutoff"
    DESCRIPTION => "Hide ordinary normal equipment after Act One"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
    WHERE @area_level > 13
  }

  RULES {
    !! Together these cover every weapon and armour base. Earlier value rules
    !! remain exceptions because they appear first in the generated filter.
    WHERE @rarity == "Normal" -> @class_use == "true" => $old_equipment_normal => $Hide
    WHERE @rarity == "Normal" -> @class_use == "false" => $old_equipment_normal => $Hide
  }
}

SECTION {
  METADATA {
    NAME        => "Magic Gear Cutoff"
    DESCRIPTION => "Hide ordinary magic equipment after Act Two"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
    WHERE @area_level > 23
  }

  RULES {
    WHERE @rarity == "Magic" -> @class_use == "true" => $old_equipment_magic => $Hide
    WHERE @rarity == "Magic" -> @class_use == "false" => $old_equipment_magic => $Hide
  }
}

SECTION {
  METADATA {
    NAME        => "Off-Class Rare Cutoff"
    DESCRIPTION => "Hide non-class-use rares after Act Two"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
    WHERE @area_level > 23
  }

  RULES {
    !! Compact/valuable-shape rares are already shown by Small Campaign Rares,
    !! which matches earlier in the file, so they remain visible regardless.
    WHERE @rarity == "Rare" -> @class_use == "false" => $old_equipment_rare => $Hide
  }
}

SECTION {
  METADATA {
    NAME        => "MartronArada Equipment"
    DESCRIPTION => "Level appropriate gear"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
  }

  RULES {
    MACRO["item_progression-equipment-leveling"
      -> $show_normal   => $equipment_normal
      -> $show_magic    => $equipment_magic
      -> $show_rare     => $equipment_rare
      -> $hidden_normal => $old_equipment_normal
      -> $hidden_magic  => $old_equipment_magic
      -> $hidden_rare   => $old_equipment_rare
    ]
  }
}

SECTION {
  METADATA {
    NAME        => "Unmatched Campaign Equipment"
    DESCRIPTION => "Hide all remaining weapons and armour"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
  }

  RULES {
    !! Normal equipment
    WHERE @rarity == "Normal" -> @class_use == "true" => $old_equipment_normal => $Hide
    WHERE @rarity == "Normal" -> @class_use == "false" => $old_equipment_normal => $Hide

    !! Magic equipment
    WHERE @rarity == "Magic" -> @class_use == "true" => $old_equipment_magic => $Hide
    WHERE @rarity == "Magic" -> @class_use == "false" => $old_equipment_magic => $Hide

    !! Rare equipment
    WHERE @rarity == "Rare" -> @class_use == "true" => $old_equipment_rare => $Show
    WHERE @rarity == "Rare" -> @class_use == "false" => $old_equipment_rare => $Show
  }
}

SECTION {
  METADATA {
    NAME        => "Campaign Flasks"
    DESCRIPTION => "Level appropriate campaign flasks"
  }

  SECTION_CONDITIONS {
    WHERE @area_level < 68
  }

  RULES {
    MACRO["item_progression-flasks"
      -> $show   => $flask_current
      -> $hidden => $flask_old
    ]
  }
}
